DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scenthaus
# Vercel builds use a direct, unpooled URL for the advisory lock.
DATABASE_URL_UNPOOLED=
ENVIRONMENT=development
SECRET_KEY=development-only-change-this-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@scenthaus.demo
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-chars
CRON_SECRET=replace-with-a-unique-random-value
DEMO_MODE=true
ARTIFACT_DIR=artifacts
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
RETENTION_DAYS=180

# Stripe-hosted Checkout; placeholders only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_PUBLIC_URL=http://localhost:5173
