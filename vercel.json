{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "storefront": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
    },
    "api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "python -m app.vercel_build",
      "functions": {
        "main.py": {
          "maxDuration": 60,
          "includeFiles": "{artifacts/**,app/real_catalog.json,ml/*.py,ml/configs/**}",
          "excludeFiles": "{tests/**,mlruns/**,mlflow.db*,.venv/**,artifacts/dataset.json,app/ml/train.py,app/ml/forecast.py,app/worker.py,ml/data/**,ml/reports/**,ml/tests/**}"
        }
      }
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": {"service": "api"}},
    {"source": "/", "destination": {"service": "storefront", "path": "/index.html"}},
    {"source": "/:path*", "destination": {"service": "storefront"}}
  ],
  "crons": [{"path": "/api/internal/maintenance", "schedule": "0 20 * * *"}]
}
